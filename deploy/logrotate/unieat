# Logrotate配置文件
# 放置位置: /etc/logrotate.d/unieat
# 系统会自动每天检查并轮转日志

/path/to/your/unieat/project/logs/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 644 www-data www-data
    postrotate
        # 重启Gunicorn以重新打开日志文件
        systemctl reload unieat
    endscript
}

/var/log/gunicorn/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 644 www-data www-data
    postrotate
        systemctl reload unieat
    endscript
}

/var/log/nginx/unieat_*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 644 www-data www-data
    postrotate
        systemctl reload nginx
    endscript
}
